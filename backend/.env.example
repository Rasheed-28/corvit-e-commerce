# ==============================================================================
# Backend Environment Configuration (.env.example)
# Copy this file to .env and adjust values for your local or production environment.
# Never commit the actual .env file or real secrets to source control.
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL / SQLite fallback if DB_ENGINE is empty)
# For local SQLite: set DB_ENGINE=django.db.backends.sqlite3
# For PostgreSQL: set DB_ENGINE=django.db.backends.postgresql
DB_ENGINE=django.db.backends.postgresql
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# CORS & CSRF Settings (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SimpleJWT Cookie Settings
JWT_ACCESS_COOKIE_NAME=access_token
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax


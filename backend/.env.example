# ==============================================================================
# Backend Environment Configuration Template (.env.example)
# Copy this file to .env and configure for your local or production environment.
# IMPORTANT: Never commit actual credentials, secret keys, or real passwords.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core Settings
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC
DJANGO_LANGUAGE_CODE=en-us

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL / Supported Driver: psycopg v3)
# ------------------------------------------------------------------------------
# Primary engine: django.db.backends.postgresql
DB_ENGINE=django.db.backends.postgresql
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=0
DB_SSLMODE=prefer

# Explicit SQLite Fallback Switch:
# If you do not have PostgreSQL running locally and need a local development fallback,
# set USE_SQLITE_FALLBACK=True or set DB_ENGINE=django.db.backends.sqlite3.
# NOTE: SQLite is NEVER silently substituted when DB_ENGINE is set to postgresql.
USE_SQLITE_FALLBACK=False

# ------------------------------------------------------------------------------
# 3. Static & Media Asset Storage
# ------------------------------------------------------------------------------
STATIC_URL=/static/
MEDIA_URL=/media/

# ------------------------------------------------------------------------------
# 4. CORS & CSRF Security (Comma-separated URLs)
# ------------------------------------------------------------------------------
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 5. Django REST Framework & JWT Settings
# ------------------------------------------------------------------------------
DRF_PAGE_SIZE=20
JWT_ACCESS_COOKIE_NAME=access_token
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax

# ------------------------------------------------------------------------------
# 6. Payment Gateway Architecture & Provider Configuration
# ------------------------------------------------------------------------------
# Active provider adapter: 'simulated' (safe test-mode for local dev) or 'stripe'
# All payment secrets remain strictly on the backend. Never commit live keys.
PAYMENT_GATEWAY=simulated

# Simulated Gateway Webhook Secret (used for HMAC-SHA256 signature verification in local dev/tests)
SIMULATED_WEBHOOK_SECRET=simulated-dev-webhook-secret-key-38d729a8f

# Stripe Gateway Credentials (leave blank when using the simulated test-mode adapter)
# Select Stripe only after confirming merchant account activation, country support,
# currencies, and accepted payment methods.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
